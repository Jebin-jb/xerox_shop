<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude temporary printable documents from cloud backup -->
        <exclude domain="root" path="app_print_vault" />
        <exclude domain="file" path="app_print_vault" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude temporary printable documents from device transfers -->
        <exclude domain="root" path="app_print_vault" />
        <exclude domain="file" path="app_print_vault" />
    </device-transfer>
</data-extraction-rules>
