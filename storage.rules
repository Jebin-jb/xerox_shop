rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /orders/{uid}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == uid || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'shopkeeper');
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 20 * 1024 * 1024;
    }
  }
}
